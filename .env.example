# ---------------------------------------------------------------------------
# AccrualFlow AI - environment configuration
# ---------------------------------------------------------------------------

# PostgreSQL connection
ACCRUALFLOW_DB_HOST=127.0.0.1
ACCRUALFLOW_DB_PORT=5433
ACCRUALFLOW_DB_USER=accrualflow
ACCRUALFLOW_DB_PASSWORD=local_dev_password

# The AccrualFlow database and the Mock ERP database are kept apart.
ACCRUALFLOW_MAIN_DB_NAME=accrualflow_db
ACCRUALFLOW_DB_NAME=mock_erp_db

# Mock ERP API base URL (used from the host and from inside Docker)
MOCK_ERP_BASE_URL=http://127.0.0.1:8001

# Writable runtime root for the raw EML archives, the attachments, the
# correction workbooks and the published Master Excel.
ACCRUALFLOW_DATA_DIR=backend/data/runtime

# Master outbound email switch.
#
#   true  -> correction requests are prepared and logged, never sent
#   false -> correction requests are actually sent through the Gmail API
#
# Keep this on true until the owner has reviewed a dry run.
ACCRUALFLOW_DRY_RUN=true

# Maximum number of correction requests per department and reporting month.
ACCRUALFLOW_MAX_CORRECTION_ATTEMPTS=3

# Reporting business timezone.
ACCRUALFLOW_REPORTING_TIMEZONE=America/Los_Angeles
